      <item>
       <widget class="QFrame" name="inventory_sideBar">
        <property name="enabled">
         <bool>true</bool>
        </property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="minimumSize">
         <size>
          <width>40</width>
          <height>0</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>40</width>
          <height>16777215</height>
         </size>
        </property>
        <property name="toolTip">
         <string notr="true">&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;Éste menú lateral permite cambiar precios usando porcentajes, para eso se sigue el siguiente procedimiento (es necesario mantener el menú lateral abierta durante el proceso):&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;1)&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; Seleccionar el &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;tipo de precio&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; que se desea modificar dentro del menú&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;2)&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; Seleccionar los &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;productos&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; a modificar en la tabla&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;3)&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; Escribir el &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;porcentaje de cambio&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; en la barra inferior del menú y presionar &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-style:italic;&quot;&gt;Enter&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;De esa forma se cambia el precio elegido de todos los &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;productos seleccionados &lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;y también se actualizan las &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700;&quot;&gt;cuentas corrientes&lt;/span&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt; con los nuevos valores.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="styleSheet">
         <string notr="true">* {
	background-color: #0d1b2a;
	color: #e0e1dd;
}


QToolTip {
	background-color: #fff;
	color: #0d1b2a;
}


#inventory_sideBar {
	border-bottom-left-radius: 20px;
}

QScrollBar {
	background-color: white;
}


/* botones */
QPushButton {
	border: none;
}
QPushButton:hover {
	border: 2px solid #38a3a5;
	border-radius: 3px;
	border-bottom-right-radius: 10px;
	padding-right: 2px;
	padding-bottom: 3px;
}


/* labels */
QLabel {
	font-family: &quot;Arial&quot;, &quot;Calibri&quot;, &quot;Sans-Serif&quot;;
	font-size: 18px;
	font-weight: 600px;
	margin-bottom: 5px;
}


#percentage_label {
	margin-top: 25px;
	margin-bottom: 0;
}


/* lineedit */
QLineEdit {
	background-color: #e0e1dd;
	color: #0d1b2a;
	border: none;
	border-top: 1px solid;
	border-bottom: 1px solid;
	border-color: #0b7e7f;
	border-radius: 10px;
	height: 24px;
}
QLineEdit:focus {
	background-color: #3b66ab;
	color: #fff;
	border: 1px solid;
	border-color: #0b7e7f;
	font-size: 18px;
}
QLineEdit:disabled {
	background-color: #bbb;
	color: #555;
}


/* checkbuttons */
</string>
